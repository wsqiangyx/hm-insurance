# ============================================================
# IDE / 编辑器 / 操作系统
# ============================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Python (uv / FastAPI / Jupyter / ruff)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/
pip-log.txt

# ============================================================
# 前端 (Vite / React / TypeScript / ESLint)
# ============================================================
**/node_modules/
**/dist/
build/
*.tsbuildinfo
.vite/
.eslintcache
coverage/
.npm/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# 环境变量
# 注意：本项目约定 .env 需要提交（如 agent-service/.env），
#       因此不忽略 .env 本身，只忽略本地覆盖文件。
# ============================================================
.env.local
.env.*.local

# ============================================================
# 日志 / 临时文件 / 备份
# ============================================================
*.log
*.tmp
*.temp
*.bak
*.orig
*.pid
*.pid.lock

# ============================================================
# 本地运行数据
# ============================================================
*.db
*.sqlite
*.sqlite3
